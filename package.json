{
  "name": "fit-dev-tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm ci --prefix web && npm ci --prefix server",
    "dev": "npm run dev --prefix web",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix web",
    "preview": "npm run preview --prefix web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
