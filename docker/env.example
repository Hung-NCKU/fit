# 複製成 docker/env 再填。這個檔案不會進映像，是執行時才讀。

# 必填：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash

# 登入密碼決定身分：輸入誰的密碼就以誰的身分登入。留空＝該帳號停用。
# 兩個都留空＝完全不需登入（別這樣開到外網）
PASSWORD_MARTINA=
PASSWORD_ELI=

# 時區。SQLite 的 localtime、每日彙總的日期切分、定時提醒都看這個，
# 不設的話容器是 UTC，台灣會差 8 小時。
TZ=Asia/Taipei

# 手機推播（選用）。留空時後端會自己產生一組並印在 log 裡，貼回來即可。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:fit@localhost
NOTIFY_HOURS=12,15,18,21

# 上傳圖片大小上限（位元組）
MAX_IMAGE_BYTES=6291456

# 自動備份（VACUUM INTO，會跟著 /data volume 走）
# BACKUP_ENABLED=false 可關掉；BACKUP_DIR 可指到別處
BACKUP_HOUR=3
BACKUP_KEEP=7
