# 到 https://aistudio.google.com/apikey 申請免費 API key，填在下面
GEMINI_API_KEY=
# 候補鏈：前面的模型當天額度用完會自動換下一個。lite 在前（額度寬、速度快），flash 備援
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash
PORT=3000

# 上傳圖片大小上限（位元組）
MAX_IMAGE_BYTES=6291456

# 外網通道方式：quick（臨時網址）/ ngrok（固定網址）/ cloudflare（自有網域）
TUNNEL_PROVIDER=quick
# ngrok：https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# ngrok 配發給你的固定網址，例如 abc-123-xyz.ngrok-free.dev
NGROK_DOMAIN=
# Cloudflare 具名通道（需自有網域）
TUNNEL_NAME=fit
TUNNEL_HOSTNAME=

# 登入密碼決定身分：輸入誰的密碼就以誰的身分登入。留空＝該帳號停用。
# 兩個都留空＝完全不需登入（只適合自己電腦上用，別這樣開到外網）
PASSWORD_MARTINA=
PASSWORD_ELI=

# 手機推播金鑰：留空時後端會自動產生一組並印出來，貼進 .env 即可
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:fit@localhost
# 每日提醒時間（24 小時制，逗號分隔）
NOTIFY_HOURS=12,15,18,21

# 自動備份：每天幾點跑、保留幾份。
# 放在 server/data/backups/，啟動時若今天還沒備份過會先補一份。
BACKUP_HOUR=3
BACKUP_KEEP=7
